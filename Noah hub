-- Floating particles drifting upward behind everything
local WINDOW_W, WINDOW_H = 460, 410
local rng = Random.new()
local particles = {}
for _ = 1, 22 do
	local size = rng:NextInteger(2, 5)
	local p = Instance.new("Frame")
	p.Size = UDim2.fromOffset(size, size)
	p.BackgroundColor3 = Color3.new(1, 1, 1)
	p.BackgroundTransparency = rng:NextNumber(0.5, 0.85)
	p.BorderSizePixel = 0
	p.ZIndex = 0
	p.Parent = window
	corner(p, size)
	table.insert(particles, {
		frame = p,
		x = rng:NextNumber(0, WINDOW_W),
		y = rng:NextNumber(0, WINDOW_H),
		speed = rng:NextNumber(8, 30),
		drift = rng:NextNumber(-6, 6),
	})
end

RunService.RenderStepped:Connect(function(dt)
	if not window.Visible then return end
	local t = os.clock()
	bgGradient.Rotation = 45 + 30 * math.sin(t * 0.5)
	borderGradient.Rotation = (t * 90) % 360
	for _, p in ipairs(particles) do
		p.y -= p.speed * dt
		p.x += p.drift * dt
		if p.y < -10 then
			p.y = WINDOW_H + 10
			p.x = rng:NextNumber(0, WINDOW_W)
		end
		p.frame.Position = UDim2.fromOffset(p.x, p.y)
	end
end)

