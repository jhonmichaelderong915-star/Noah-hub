-- Fly -----------------------------------------------------------------
-- Controls: move with your normal movement keys / joystick toward where the
-- camera looks. Space = up, LeftCtrl = down.
local flyBV, flyBG

local function stopFly()
	if flyBV then flyBV:Destroy() flyBV = nil end
	if flyBG then flyBG:Destroy() flyBG = nil end
end

local function startFly()
	local char = player.Character
	local root = char and char:FindFirstChild("HumanoidRootPart")
	if not root then return end
	stopFly()

	flyBV = Instance.new("BodyVelocity")
	flyBV.MaxForce = Vector3.new(1e5, 1e5, 1e5)
	flyBV.Velocity = Vector3.zero
	flyBV.Parent = root

	flyBG = Instance.new("BodyGyro")
	flyBG.MaxTorque = Vector3.new(1e5, 1e5, 1e5)
	flyBG.P = 1e4
	flyBG.CFrame = root.CFrame
	flyBG.Parent = root
end

RunService.RenderStepped:Connect(function()
	if not (state.flyEnabled and flyBV and flyBG) then return end
	local cam = workspace.CurrentCamera
	local hum = getHumanoid()
	if not (cam and hum) then return end

	local move = cam.CFrame:VectorToObjectSpace(hum.MoveDirection)
	local dir = cam.CFrame.LookVector * -move.Z + cam.CFrame.RightVector * move.X
	if UserInputService:IsKeyDown(Enum.KeyCode.Space) then
		dir += Vector3.yAxis
	end
	if UserInputService:IsKeyDown(Enum.KeyCode.LeftControl) then
		dir -= Vector3.yAxis
	end
	if dir.Magnitude > 1 then
		dir = dir.Unit
	end
	flyBV.Velocity = dir * state.flySpeed
	flyBG.CFrame = cam.CFrame
end)

player.CharacterAdded:Connect(function()
	flyBV, flyBG = nil, nil
	task.wait(0.3)
	if state.flyEnabled then
		startFly()
	end
end)

-- Noclip --------------------------------------------------------------
-- Turns off collisions on your character's parts while enabled.
local noclipTouched = {}

RunService.Stepped:Connect(function()
	local char = player.Character
	if not char then return end
	if state.noclip then
		for _, part in ipairs(char:GetDescendants()) do
			if part:IsA("BasePart") and part.CanCollide then
				noclipTouched[part] = true
				part.CanCollide = false
			end
		end
	elseif next(noclipTouched) then
		for part in pairs(noclipTouched) do
			if part and part.Parent then
				part.CanCollide = true
			end
		end
		noclipTouched = {}
	end
end)

-- Character size (R15 only) -------------------------------------------
-- Uses the Humanoid's scale values. Works in your own place for testing.
local SCALE_NAMES = { "BodyHeightScale", "BodyWidthScale", "BodyDepthScale", "HeadScale" }

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local sizePending = false

local function applySize()
	-- Ask the server to scale (needs SizeServer.server.lua in ServerScriptService)
	if sizePending then return end
	sizePending = true
	task.delay(0.1, function()
		sizePending = false
		local remote = ReplicatedStorage:FindFirstChild("SetSize")
		if remote then
			remote:FireServer(state.sizePercent / 100)
		else
			warn("SpeedPanel: SetSize remote not found. Add SizeServer to ServerScriptService.")
		end
	end)
end

player.CharacterAdded:Connect(function()
	task.wait(0.5)
	applySize()
end)

